# Run inference natively in LM Studio on the Mac. No cloud fallback exists.
WORKBENCH_DATA=./data
WORKBENCH_PROFILE=college
WORKBENCH_COLLEGE_CONFIG=./config/college.yaml
WORKBENCH_REGISTRY=./config/registry.yaml
WORKBENCH_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
WORKBENCH_SECURE_COOKIES=false
WORKBENCH_WORKERS=2
WORKBENCH_QUEUE_TOTAL=50
WORKBENCH_QUEUE_PER_USER=10
# Serial inference protects the model host while two jobs can be active.
WORKBENCH_MODEL_CONCURRENCY=1
# Large vision requests on the Mac can take several minutes.
WORKBENCH_MODEL_TIMEOUT=600
# Optional LM Studio bearer token. Keep this only in the untracked .env file.
WORKBENCH_LM_STUDIO_API_KEY=
WORKBENCH_SANDBOX_IMAGE=chaturya-sandbox:local
WORKBENCH_SANDBOX_ENABLED=true
# Required only for optional direct-LAN Docker Compose:
# WORKBENCH_LM_HOST=<Mac LAN IP reachable from Docker>
# WORKBENCH_LM_PORT=1234
# WORKBENCH_SANDBOX_MOUNT_ROOT=<absolute host path to data>
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
TRANSFORMERS_OFFLINE=1
DO_NOT_TRACK=1
LANGSMITH_TRACING=false
NEXT_TELEMETRY_DISABLED=1
OTEL_SDK_DISABLED=true

